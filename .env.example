# StudyLens configuration (no secrets)
DATA_DIR=./data
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_WORDS=150
CHUNK_OVERLAP=30
TOP_K=4
RRF_K=60
MIN_CONFIDENCE=0.30
MAX_HISTORY_TURNS=6
LLM_MAX_TOKENS=512

# LLM provider config: gemini | ollama | groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Provider API keys (leave empty if unused)
GEMINI_API_KEY=
GROQ_API_KEY=
