# StudyLens configuration (no secrets)
DATA_DIR=./data
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_WORDS=150
CHUNK_OVERLAP=30
TOP_K=4
RRF_K=60
MIN_CONFIDENCE=0.22
MAX_HISTORY_TURNS=6
LLM_MAX_TOKENS=512

# Online prototype defaults (Gemini cloud API)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Optional local/offline providers
OLLAMA_BASE_URL=http://localhost:11434

# Provider API keys (required for cloud LLM)
GEMINI_API_KEY=
GROQ_API_KEY=
